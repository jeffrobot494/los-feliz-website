{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1170px"
		},
		"spacing": {
			"blockGap": null,
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "2xs", "name": "2XS", "size": "8px" },
				{ "slug": "xs", "name": "XS", "size": "16px" },
				{ "slug": "sm", "name": "SM", "size": "24px" },
				{ "slug": "md", "name": "MD", "size": "40px" },
				{ "slug": "lg", "name": "LG", "size": "64px" },
				{ "slug": "xl", "name": "XL", "size": "96px" }
			]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "nav", "name": "Deep purple", "color": "#71018A" },
				{ "slug": "accent", "name": "Purple", "color": "#B209D7" },
				{ "slug": "accent-soft", "name": "Lavender", "color": "#E2B4F0" },
				{ "slug": "head", "name": "Heading brown", "color": "#675444" },
				{ "slug": "h3", "name": "Subhead gray", "color": "#7D7D7D" },
				{ "slug": "ink", "name": "Body gray", "color": "#6B6B6B" },
				{ "slug": "light", "name": "Light gray", "color": "#F5F5F5" },
				{ "slug": "band", "name": "Band gray", "color": "#747474" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "13px" },
				{ "slug": "small", "name": "Small", "size": "15px" },
				{ "slug": "button", "name": "Button", "size": "15px" },
				{ "slug": "body", "name": "Body", "size": "18px" },
				{ "slug": "lead", "name": "Lead", "size": "20px" },
				{ "slug": "h4", "name": "Heading 4", "size": "22px" },
				{ "slug": "h3", "name": "Heading 3", "size": "32px" },
				{ "slug": "h2", "name": "Heading 2", "size": "40px" },
				{ "slug": "h1", "name": "Heading 1", "size": "48px" },
				{ "slug": "display-sm", "name": "Display small", "size": "40px" },
				{ "slug": "display", "name": "Display", "size": "64px" }
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Comfortaa",
					"fontFamily": "Comfortaa, 'Varela Round', Nunito, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Comfortaa",
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Comfortaa-VariableFont_wght.woff2" ]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Quicksand",
					"fontFamily": "Quicksand, 'Varela Round', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Quicksand",
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Quicksand-VariableFont_wght.woff2" ]
						}
					]
				}
			]
		},
		"custom": {
			"radius": {
				"blob": "355px 45px 225px 75px / 15px 225px 15px 255px",
				"irregular": "155px 45px 225px 75px / 15px 125px 15px 155px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h1)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h3)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--h4)" } },
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--button)",
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	]
}
